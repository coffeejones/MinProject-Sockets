@startuml
skinparam monochrome true
skinparam style strictuml
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam maxMessageSize 210
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor black
  ParticipantFontColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ActivationBorderColor black
  ActivationBackgroundColor white
  ArrowColor black
  GroupBackgroundColor white
  GroupBodyBackgroundColor white
  GroupBorderColor black
  DividerBackgroundColor white
  DividerBorderColor black
  ReferenceBackgroundColor white
  ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
hide footbox
title Vælg brugernavn
participant "Klient\n«delsystem»" as C
participant "handler:ClientHandler" as H
participant "service:ChatService" as S
participant "state:ChatState" as D
activate C
C ->> H : LOGIN||Alice
deactivate C
activate H
H -> S : handle(peer, command)
activate S
S -> D : register(peer, "alice")
activate D
D -->> S : LoginResult
deactivate D
alt SUCCESS
  S -> H : send(LOGIN_OK)
  activate H
  H ->> C : LOGIN_OK: lobby, alice
  deactivate H
  activate C
  C -> C : Gem navn og rum = lobby;\nfrigiv næste kommando
  deactivate C
else NAME_TAKEN
  S -> H : send(ERROR)
  activate H
  H ->> C : ERROR: navnet er optaget
  deactivate H
  activate C
  C -> C : Vis fejl; tillad nyt login
  deactivate C
end
deactivate S
deactivate H
note over S, D : Navnet normaliseres. register() registrerer\nnavn og medlemskab af lobby under samme lås.
caption Klient = brugerflade + ChatConnection + ServerListener. Udvalgte kald; TCP-svar er forkortet.
@enduml
