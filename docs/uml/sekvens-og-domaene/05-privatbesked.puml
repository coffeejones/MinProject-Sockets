@startuml
skinparam monochrome true
skinparam style strictuml
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam titleFontSize 20
skinparam ArrowFontSize 14
skinparam maxMessageSize 210
skinparam sequence {
  ParticipantBackgroundColor white
  ParticipantBorderColor black
  ParticipantFontColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor white
  ActivationBorderColor black
  ActivationBackgroundColor white
  ArrowColor black
  GroupBackgroundColor white
  GroupBodyBackgroundColor white
  GroupBorderColor black
  DividerBackgroundColor white
  DividerBorderColor black
  ReferenceBackgroundColor white
  ReferenceBorderColor black
}
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
hide footbox
title Send en privatbesked
participant "Alices klient\n«delsystem»" as C
participant "alice:ClientHandler" as H
participant "service:ChatService" as S
participant "state:ChatState" as D
participant "bob:ClientHandler" as B
participant "Bobs klient\n«delsystem»" as BC
activate C
C ->> H : PRIVATE|bob|Hej Bob
deactivate C
activate H
H -> S : handle(peer, command)
activate S
S -> D : user("bob")
activate D
D -->> S : Optional<ClientPeer>
deactivate D
alt Bob findes i registeret
  S -> B : send(PRIVATE)
  activate B
  B ->> BC : PRIVATE: alice, "Hej Bob"
  activate BC
  deactivate BC
  B -->> S : skrevet og flushet
  deactivate B
  S -> H : send(INFO)
  activate H
  H ->> C : INFO: privatbesked sendt
  deactivate H
else Bob er ikke online
  S -> H : send(ERROR)
  activate H
  H ->> C : ERROR: brugeren er offline
  deactivate H
end
activate C
C -> C : Vis status; frigiv næste kommando
deactivate C
deactivate S
deactivate H
note over C, BC : Kun modtageren får privatteksten. INFO er ingen læsekvittering.\nSuccesgrenen viser vellykket skrivning; skrivefejl giver ERROR i stedet for INFO.
caption Klient = brugerflade + ChatConnection + ServerListener. Udvalgte kald; TCP-svar er forkortet.
@enduml
